{
  "name": "nocturne-ai-novel",
  "version": "0.1.5",
  "description": "AI visual novel desktop MVP",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "unpacked:win": "npm run build && electron-builder --win --dir",
    "pack:win": "npm run build && electron-builder --win portable",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "dotenv": "^16.5.0",
    "openai": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.nocturne.aivisualnovel",
    "productName": "Nocturne AI Novel",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json", "!**/.env", "!src/**/*"],
    "asar": true,
    "win": { "target": ["portable", "nsis"] },
    "portable": { "artifactName": "Nocturne-AI-Novel-${version}-portable.exe" },
    "nsis": { "artifactName": "Nocturne-AI-Novel-Setup-${version}.exe", "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
